# URL publique de l'API Fastify (sans slash final). Vide = site en mode démo (réservations simulées).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase (interface /admin). Valeurs publiques du projet Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casbah-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casbah-dev
# 1 = utiliser les émulateurs locaux (pnpm emulators)
NEXT_PUBLIC_FIREBASE_EMULATOR=1
