# ── Serveur ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Origine du site (CORS + liens dans les messages). Plusieurs valeurs séparées par des virgules.
WEB_URL=http://localhost:3000,https://souhailsouid.github.io
# Chemin public du site (GitHub Pages : /casbah). Vide si domaine dédié.
WEB_BASE_PATH=/casbah

# ── Firebase / Firestore ────────────────────────────────────────
FIREBASE_PROJECT_ID=casbah-dev
# En prod : injectés depuis Secret Manager. En local : laisser vide et utiliser les émulateurs.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Émulateurs locaux (pnpm emulators)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── E-mail (Resend) — vide = mode console (log seulement) ───────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=La Casbah <reservations@example.com>

# ── WhatsApp Cloud API (Meta) — vide = mode console ─────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0

# ── Crons (Cloud Scheduler) ─────────────────────────────────────
CRON_SECRET=change-me
# Secret des liens d'annulation (HMAC). Générer : openssl rand -base64 32
CANCEL_TOKEN_SECRET=change-me-too
