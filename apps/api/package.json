{
  "name": "@casbah/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de réservation La Casbah (Fastify, Firestore, WhatsApp Cloud API, Resend)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@casbah/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@react-email/components": "^0.0.31",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^6.1.0",
    "firebase-admin": "^13.6.1",
    "react": "19.1.0",
    "resend": "^4.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
