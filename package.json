{
  "name": "casbah",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "La Casbah — site vitrine, API de réservation et interface marchand (hammam · spa · restaurant, Roissy-en-Brie)",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "dev:api": "pnpm -C apps/api dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @casbah/shared build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "emulators": "firebase emulators:start --only firestore,auth --project casbah-dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
